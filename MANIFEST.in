# Deliberate portable source allowlist. Old work/output trees are not inputs.
include README.md AGENTS.md LICENSE pyproject.toml MANIFEST.in .gitignore requirements-build.txt
recursive-include crypto_reconciliation_lab *.py *.html *.css *.js
recursive-include tests *.py
include fixtures/stage1_history.json fixtures/stage3_3_schema2_history.json
include scripts/build_release.py scripts/reproduce_review.py scripts/verify_release.py
include scripts/release_test_scope.py scripts/release_financial_scope.py
include contracts/release-tests-baseline-0.6.0.json contracts/release-test-scope-0.6.1.json
include docs/stage6_1/scope-contract.md docs/stage6_1/release-guide.md
include docs/stage6_1/financial-scope.md
include scripts/run_ab_stage3_3.py scripts/ab_worker_stage3_3.py scripts/ab_retention_stage3_3.py scripts/measure_stage3_3.py
include docs/model_contract.md docs/correction_semantics.md docs/problem_evidence.md
include docs/stage2/baseline-schema.json
include docs/stage5/experiment_contract.md docs/stage5/ai_constraints.txt
include docs/stage6/five-minute-review.md docs/stage6/technical-presentation-tr.md
include docs/stage6/claim-evidence.md docs/stage6/historical-evidence.md
include docs/stage6/verification-guide.md docs/stage6/build-contract.md docs/stage6/ci.md
include docs/stage6/financial-reference.json
recursive-include docs/stage6/evidence *.json *.md
recursive-include examples/triage-review *.json *.md
recursive-include .github/workflows *.yml *.yaml
include docs/showcase/README.tr.md
include docs/showcase/case-study.svg
include docs/showcase/architecture.svg
include docs/showcase/demo-overview.png
include docs/showcase/assets-manifest.json
global-exclude *.pyc *.pyo .DS_Store *.sqlite3 *.db *.sqlite3-* *.key *.pem .env .env.*
prune .git
prune .venv
prune work
prune build
prune dist
prune review
prune stage5-output
prune stage5_1-output
prune stage6-output
prune stage6_1-output

# Stage 9 finite admission, fixed release/recovery scope and bounded documentation.
include scripts/release_admission_scope.py
include contracts/release-test-scope-0.7.0.json contracts/admission-recovery-scope-v1.json
include docs/stage9/admission-contract.md docs/stage9/decisions.md
include docs/stage9/recovery-report.md docs/stage9/fixture-changes.md docs/stage9/HANDOFF.md

# Stage 9.1 fixed semantic recovery scope; historical v1 sources remain included.
include contracts/release-test-scope-0.7.1.json contracts/admission-recovery-scope-v2.json
include crypto_reconciliation_lab/admission/recovery_scope_v2.json
include docs/stage9_1/S9-F1.md docs/stage9_1/S9-F2.md docs/stage9_1/decisions.md
include docs/stage9_1/fixture-changes.md docs/stage9_1/HANDOFF.md
include tests/fixtures/admission-semantic-report-v2.json

# Stage 10 optional source authentication and fixed reviewed test roster.
include requirements-auth.txt contracts/release-test-scope-0.8.0.json
include docs/stage10/fixture-changes.md
include contracts/source-auth-scope-v1.json
include crypto_reconciliation_lab/source_auth/experiment_scope_v1.json
recursive-include docs/stage10 *.md

# Stage 10.1 verifier-only maintenance; old scope remains immutable.
include contracts/release-test-scope-0.8.1.json
recursive-include docs/stage10_1 *.md
